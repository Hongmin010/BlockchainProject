# ============================================================
#  환경변수 예시 파일
#  실제 값은 .env 에 채워넣고, .env 는 절대 커밋하지 말 것.
# ============================================================

# ----- 체인 연동 -----
# 이더리움 RPC 엔드포인트 (Alchemy / Infura / 자체 노드 / 로컬 hardhat 등)
RPC_URL=

# 강화 컨트랙트 주소 (체크섬 형식, 0x + 40 hex)
CONTRACT_ADDRESS=

# ----- DB -----
# PostgreSQL 접속 문자열
# 예) postgres://user:password@localhost:5432/khu_blockchain
DATABASE_URL=

# ----- API 서버 -----
# Express 가 바인딩할 포트 (기본 3000)
PORT=3000

# ----- 인덱서 -----
# 폴링 주기 (ms). 평균 블록타임(약 12초)을 고려한 기본값
POLL_INTERVAL_MS=12000

# 한 번에 getLogs 로 조회할 블록 범위. 너무 크면 RPC 한도 초과,
# 너무 작으면 백필 시 호출 횟수가 폭증한다. 1000은 경험적 안전값.
BATCH_SIZE=1000

# reorg 안전 버퍼. "latestBlock - CONFIRMATION_BLOCKS" 까지만 확정 인덱싱.
# 메인넷 5~12, 테스트넷은 더 짧게 잡아도 무방.
CONFIRMATION_BLOCKS=5
