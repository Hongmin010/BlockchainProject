# ============================================================
#  환경변수 예시 파일
#  실제 값은 .env 에 채워넣고, .env 는 절대 커밋하지 말 것.
# ============================================================

# ----- 체인 연동 -----
# 이더리움 RPC 엔드포인트 (Base Sepolia — Alchemy / Infura / 자체 노드 등)
RPC_URL=

# 강화 컨트랙트 주소 (체크섬 형식, 0x + 40 hex)
# 배포본: 0x73e8bbe5ea755376ddd30ea1a2df3dae5d289a59 (Base Sepolia, Chain ID 84532, Merkle 버전)
CONTRACT_ADDRESS=

# 고급강화(상급) 컨트랙트 주소. base 컨트랙트를 baseGame 으로 참조하는 별도 배포본.
# 배포본: 0x4f1c8573446efc5ae48eb453cfc66fafe26c2f5c (Base Sepolia, Chain ID 84532)
ADVANCED_CONTRACT_ADDRESS=

# ----- DB -----
# PostgreSQL 접속 문자열
#  - 로컬:            postgres://khu_user:password@localhost:5432/khu_blockchain
#  - Supabase 로컬용:  Session Pooler (포트 5432, IPv4) 권장
#                      Direct 연결(db.<ref>.supabase.co:5432)은 무료 tier 에서 IPv6 전용이라
#                      IPv4 망에선 연결이 안 될 수 있음. 인덱서는 트랜잭션을 쓰므로 session 모드 필수.
#  - Supabase Render용: Transaction Pooler (포트 6543) — API 는 단일 쿼리뿐이라 안전
DATABASE_URL=

# SSL 강제 토글 (선택)
#  - 미설정 시: URL 에 'supabase.com' 또는 'sslmode=require' 가 있으면 자동 SSL 사용.
#  - 로컬 PostgreSQL 에 굳이 끄고 싶으면 false, 강제로 켜려면 true.
# DATABASE_SSL=true

# ----- API 서버 -----
# Express 가 바인딩할 포트 (기본 3000)
PORT=3000

# ----- 인덱서 -----
# 폴링 주기 (ms). 평균 블록타임(약 12초)을 고려한 기본값
POLL_INTERVAL_MS=12000

# 한 번에 getLogs 로 조회할 블록 범위. 너무 크면 RPC 한도 초과,
# 너무 작으면 백필 시 호출 횟수가 폭증한다. 1000은 경험적 안전값.
BATCH_SIZE=1000

# reorg 안전 버퍼. "latestBlock - CONFIRMATION_BLOCKS" 까지만 확정 인덱싱.
# 메인넷 5~12, 테스트넷은 더 짧게 잡아도 무방.
CONFIRMATION_BLOCKS=5
